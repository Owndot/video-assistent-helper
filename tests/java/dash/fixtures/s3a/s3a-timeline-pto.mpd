<?xml version="1.0" encoding="UTF-8"?>
<!-- S3a: Zeitleisten mit implizitem t, positiven Wiederholungen, r=-1 bis zum naechsten S und bis zum Periodenende,
     presentationTimeOffset und unterschiedlichen Timescales; $Time$ (Video) und $Number%05d$ mit Zeitleiste (Audio). -->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT60S" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <Period id="main">
    <AdaptationSet contentType="video" mimeType="video/mp4" codecs="avc1.64001f" segmentAlignment="true">
      <SegmentTemplate timescale="90000" presentationTimeOffset="900000" initialization="v/$RepresentationID$/init.mp4" media="v/$RepresentationID$/t$Time$.m4s">
        <SegmentTimeline>
          <S t="540000" d="360000" r="5"/>
          <S d="360000" r="-1"/>
          <S t="3780000" d="360000"/>
          <S d="360000" r="-1"/>
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="720" bandwidth="2500000" width="1280" height="720"/>
      <Representation id="360" bandwidth="800000" width="640" height="360"/>
    </AdaptationSet>
    <AdaptationSet contentType="audio" mimeType="audio/mp4" codecs="mp4a.40.2" lang="de">
      <Role schemeIdUri="urn:mpeg:dash:role:2011" value="main"/>
      <SegmentTemplate timescale="48000" startNumber="7" initialization="a/init.mp4" media="a/seg-$Number%05d$.m4s">
        <SegmentTimeline><S t="0" d="192000" r="-1"/></SegmentTimeline>
      </SegmentTemplate>
      <Representation id="a128" bandwidth="128000" audioSamplingRate="48000"/>
    </AdaptationSet>
  </Period>
</MPD>
