<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT8M" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <BaseURL>https://cdn2.example/content/</BaseURL>
  <Period id="1">
    <BaseURL>p1/</BaseURL>
    <AdaptationSet contentType="video" mimeType="video/mp4" codecs="avc1.64001f">
      <BaseURL>video/</BaseURL>
      <SegmentTemplate timescale="1000" duration="4000" startNumber="1" initialization="$RepresentationID$/init.jpg" media="$RepresentationID$/$Number$.jpg"/>
      <Representation id="720" bandwidth="2500000" width="1280" height="720"/>
      <Representation id="360" bandwidth="800000" width="640" height="360"><BaseURL>../lowres/</BaseURL></Representation>
    </AdaptationSet>
    <AdaptationSet contentType="audio" mimeType="audio/mp4" codecs="mp4a.40.2" lang="de">
      <BaseURL>https://audio.example/a/</BaseURL>
      <SegmentTemplate timescale="48000" duration="192000" startNumber="0" initialization="init-$Bandwidth$.mp4" media="seg-$Bandwidth$-$Number%04d$.m4s?tok=1"/>
      <Representation id="a1" bandwidth="128000"/>
    </AdaptationSet>
  </Period>
</MPD>
