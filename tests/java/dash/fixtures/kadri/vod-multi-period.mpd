<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT10M15S" minBufferTime="PT2S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <Period id="pre-roll" duration="PT15S">
    <AdaptationSet mimeType="video/mp4" codecs="avc1.4d401f" contentType="video">
      <SegmentTemplate timescale="1000" duration="5000" initialization="ad/init.mp4" media="ad/$Number$.m4s" startNumber="1"/>
      <Representation id="ad" bandwidth="1000000" width="1280" height="720"/>
    </AdaptationSet>
  </Period>
  <Period id="main" start="PT15S">
    <AdaptationSet mimeType="video/mp4" codecs="avc1.640028" contentType="video">
      <SegmentTemplate timescale="1000" duration="4000" initialization="main/$RepresentationID$/init.mp4" media="main/$RepresentationID$/$Number$.m4s" startNumber="1"/>
      <Representation id="720" bandwidth="2500000" width="1280" height="720"/>
      <Representation id="1080" bandwidth="5000000" width="1920" height="1080"/>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4" codecs="mp4a.40.2" contentType="audio" lang="de">
      <SegmentTemplate timescale="1000" duration="4000" initialization="main/a/init.mp4" media="main/a/$Number$.m4s" startNumber="1"/>
      <Representation id="a" bandwidth="128000"/>
    </AdaptationSet>
  </Period>
</MPD>
