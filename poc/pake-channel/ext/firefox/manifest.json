{
  "manifest_version": 2,
  "name": "Kadri PAKE PoC (throwaway test extension, not Kadri)",
  "version": "0.0.2",
  "description": "Isolated feasibility proof. Throwaway identities only.",
  "browser_specific_settings": { "gecko": { "id": "kadri-pake-poc@example.invalid", "strict_min_version": "128.0" } },
  "background": { "page": "background.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "http://127.0.0.1/*"],
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
