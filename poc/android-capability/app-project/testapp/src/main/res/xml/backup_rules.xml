<?xml version="1.0" encoding="utf-8"?>
<!-- Android 10/11 (minSdk 29): backup is already off via allowBackup="false";
     these rules exclude everything as well, in case it is ever turned on. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
