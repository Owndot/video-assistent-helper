{
  "manifest_version": 3,
  "name": "TEST – Kadri Android capability PoC (not Kadri)",
  "version": "0.1.0",
  "description": "Isolated Android/Vivaldi capability test. Throwaway identities only. Not a product.",
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "TEST Kadri PoC", "default_popup": "selftest.html" },
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
